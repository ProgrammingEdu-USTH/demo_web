  "code": "from collections import deque\n\nban_do = {\n    \"Kho\": [\"A\", \"B\"], \"A\": [\"C\"], \"B\": [\"C\", \"D\"],\n    \"C\": [\"Khách\"], \"D\": [\"Khách\"], \"Khách\": [],\n}\n\ndef bfs(bat_dau, dich):\n    hang_doi = deque([[bat_dau]])\n    da_tham = {bat_dau}\n    while hang_doi:\n        duong = hang_doi.popleft()\n        nut = duong[-1]\n        if nut == dich:\n            return duong\n        for ke in ban_do[nut]:\n            if ke not in da_tham:\n                da_tham.add(ke)\n                hang_doi.append(duong + [ke])\n\nprint(bfs(\"Kho\", \"Khách\"))",
  "actors": [{ "id": "bit", "sprite": "bit-dispatch", "at": "office" }],
  "steps": [
    {
      "line": [3, 6],
      "caption": "ban_do là một đồ thị: mỗi ngã tư là một đỉnh, mỗi con đường là một cạnh. Từ mỗi đỉnh có danh sách các đỉnh kề đi tới được.",
      "actions": [
        { "type": "highlight", "target": "node.Kho" },
        { "type": "highlight", "target": "node.A" },
        { "type": "highlight", "target": "node.B" },
        { "type": "highlight", "target": "node.C" },
        { "type": "highlight", "target": "node.D" },
        { "type": "highlight", "target": "node.Khách" }
      ]
    },
