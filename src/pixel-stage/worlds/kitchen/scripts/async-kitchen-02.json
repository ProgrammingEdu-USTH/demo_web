  "language": "python",
  "code": "import asyncio\n\nasync def nuong(mon, giay):\n    print(f\"Cho {mon} vào lò\")\n    await asyncio.sleep(giay)\n    print(f\"{mon} xong!\")\n    return mon\n\nasync def main():\n    a = await nuong(\"Pizza\", 3)\n    b = await nuong(\"Bánh mì\", 1)\n    print([a, b])\n\nasyncio.run(main())",
