  "language": "python",
  "code": "import asyncio\n\nasync def nuong(mon, giay):\n    print(f\"Cho {mon} vào lò\")\n    await asyncio.sleep(giay)\n    print(f\"{mon} xong!\")\n    return mon\n\nasync def main():\n    ket_qua = await asyncio.gather(\n        nuong(\"Pizza\", 3),\n        nuong(\"Bánh mì\", 1),\n    )\n    print(ket_qua)\n\nasyncio.run(main())",
  "actors": [{ "id": "cook", "sprite": "cook", "at": "prep" }],
  "steps": [
    {
      "line": 16,
      "caption": "asyncio.run(main()) khởi động event loop. Bếp trưởng Bit vào ca và bật đèn bếp.",
      "actions": [
        { "type": "spawn", "actor": "bit", "sprite": "bit-chef", "at": "door" },
        { "type": "move", "actor": "bit", "to": "center", "dur": "lg", "after": 0 },
        { "type": "set", "key": "light", "value": "on", "after": 1 },
        { "type": "say", "actor": "bit", "text": "Mở bếp!", "after": 1 }
      ]
    },
    {
      "line": [10, 13],
      "caption": "gather nhận hai coroutine, mỗi món là một ticket treo trên ray. Khay ra món có sẵn 2 ô, đánh số theo thứ tự gọi.",
