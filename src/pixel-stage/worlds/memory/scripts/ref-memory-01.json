  "code": "gio_hang = [\"táo\", \"sữa\"]   # tạo object\nban_sao = gio_hang          # thêm nhãn thứ 2, cùng một hộp\nban_sao.append(\"bánh\")      # gio_hang cũng thấy \"bánh\"\ndel gio_hang                # gỡ 1 nhãn, hộp vẫn còn\nban_sao = None              # hết nhãn → hộp được dọn",
