        { "type": "say", "actor": "bit", "text": "Xin chào, Bit" },
        { "type": "anim", "actor": "bit", "tag": "happy" }
      ]
    },
    {
      "line": 3,
      "caption": "Biến hop bắt đầu bằng 3, như một cái hộp đặt trên kệ.",
      "vars": { "ten": "'Bit'", "hop": "3" },
      "actions": [
        { "type": "anim", "actor": "bit", "tag": "idle" },
