{
  "id": "demo-blank-01",
  "world": "blank",
  "language": "python",
  "code": "ten = \"Bit\"\nprint(\"Xin chào, \" + ten)\nhop = 3\nwhile hop > 0:\n    hop = hop - 1\nprint(\"Xong!\")",
  "actors": [],
  "steps": [
    {
      "line": 1,
      "caption": "Gán chuỗi “Bit” cho biến ten. Bit xuất hiện, nhãn dưới chân là tên biến.",
      "vars": { "ten": "'Bit'" },
      "actions": [{ "type": "spawn", "actor": "bit", "sprite": "bit", "at": "center", "label": "ten" }]
    },
    {
      "line": 2,
      "caption": "print ghép hai chuỗi rồi in ra màn hình: Xin chào, Bit.",
