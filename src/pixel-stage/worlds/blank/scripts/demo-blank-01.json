        { "type": "highlight", "target": "hop" },
        { "type": "timer", "at": "sign", "seconds": 3 }
      ]
    },
    {
      "line": [4, 5],
      "caption": "Điều kiện hop > 0 đúng nên thân vòng lặp chạy: hop giảm còn 2.",
      "vars": { "ten": "'Bit'", "hop": "2" },
      "actions": [
        { "type": "move", "actor": "bit", "to": "right" },
        { "type": "label", "target": "hop", "text": "hop = 2", "after": 0 },
        { "type": "emit", "at": "shelf", "fx": "spark", "after": 0 },
        { "type": "anim", "actor": "bit", "tag": "work", "after": 0 },
        { "type": "timer", "at": "sign", "seconds": 2, "after": 0 }
      ]
    },
    {
      "line": [4, 5],
      "caption": "Vòng thứ hai: hop còn 1. Camera phóng to để nhìn kỹ hơn.",
      "vars": { "ten": "'Bit'", "hop": "1" },
      "actions": [
        { "type": "camera", "to": "focus", "zoom": 2 },
        { "type": "label", "target": "hop", "text": "hop = 1", "after": 0 },
        { "type": "set", "key": "glow", "value": true },
        { "type": "timer", "at": "sign", "seconds": 1, "after": 0 }
      ]
    },
    {
      "line": [4, 5],
      "caption": "Vòng thứ ba: hop về 0, điều kiện sai nên vòng lặp dừng.",
      "vars": { "ten": "'Bit'", "hop": "0" },
      "actions": [
        { "type": "label", "target": "hop", "text": "hop = 0" },
        { "type": "wait", "dur": "sm" },
        { "type": "camera", "to": "center", "zoom": 1, "after": 1 },
        { "type": "despawn", "actor": "hop", "fx": "poof", "after": 2 },
        { "type": "timer", "at": "sign", "seconds": 0, "after": 2 },
        { "type": "anim", "actor": "bit", "tag": "confused", "after": 2 }
      ]
    },
    {
      "line": 6,
      "caption": "Ra khỏi vòng lặp, chương trình in “Xong!”.",
      "vars": { "ten": "'Bit'", "hop": "0" },
      "actions": [
        { "type": "move", "actor": "bit", "to": "center" },
        { "type": "anim", "actor": "bit", "tag": "happy", "after": 0 },
        { "type": "say", "actor": "bit", "text": "Xong!", "after": 0 },
        { "type": "emit", "at": "bit", "fx": "note", "after": 0 },
        { "type": "set", "key": "glow", "value": false, "after": 0 }
      ]
