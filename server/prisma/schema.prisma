/// Ngân hàng câu hỏi đầu vào, có phiên bản. questions_json CHỨA ĐÁP ÁN ĐÚNG: chỉ server đọc để chấm,
/// gửi ra FE phải bỏ cờ đáp án (xem bẫy "lộ đáp án" ở AGENTS.md). Chỉ một bản is_active tại một thời điểm —
/// do service giữ (Prisma không biểu diễn được chỉ mục từng phần nên không đặt ở DB).
model Questionnaire {
  id            Int     @id @default(autoincrement())
  version       Int     @unique(map: "uq_questionnaires_version")
  title         String?
  questionsJson Json    @map("questions_json") @db.JsonB
  isActive      Boolean @default(false) @map("is_active")

  placementAttempts PlacementAttempt[]

  @@map("questionnaires")
}

/// Một lượt làm bài đầu vào của một người (khách cũng là một dòng users, nên dùng chung bảng này).
/// answers[i] = chỉ số lựa chọn người đó chọn cho câu thứ i của bản câu hỏi (-1 = bỏ qua); score/total do SERVER chấm.
/// Mỗi người một lượt cho mỗi phiên bản câu hỏi (unique) nên gửi lại là idempotent; muốn cho làm lại thì thêm cột attempt_no.
/// CHECK (score/total/độ dài answers) nằm trong migration, Prisma không biểu diễn.
model PlacementAttempt {
  id              BigInt   @id @default(autoincrement())
  userId          Int      @map("user_id")
  questionnaireId Int      @map("questionnaire_id")
  answers         Int[]    @db.SmallInt
  score           Int      @db.SmallInt
  total           Int      @db.SmallInt
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionnaire Questionnaire @relation(fields: [questionnaireId], references: [id])

  @@unique([userId, questionnaireId], map: "uq_placement_user_questionnaire")
  @@index([questionnaireId], map: "idx_placement_questionnaire")
  @@map("placement_attempts")
}

model UserDailyXpLog {
  id       Int      @id @default(autoincrement())
  userId   Int      @map("user_id")
  logDate  DateTime @map("log_date") @db.Date
  xpEarned Int      @map("xp_earned")

  user User @relation(fields: [userId], references: [id])

  // Mỗi người MỘT hàng mỗi ngày — để addDailyXp() upsert được (BE3, migration
  // 20261111000000_daily_xp_log_unique).
  @@unique([userId, logDate], map: "uq_daily_xp_user_date")
  // Leaderboard tuần: SUM(xp_earned) theo (user_id, khoảng log_date).
  // Thừa từ khi có unique bên dưới, nhưng GIỮ: migration chỉ được THÊM (AGENTS.md).
  @@index([userId, logDate], map: "idx_daily_xp_user_date")
  @@map("user_daily_xp_logs")
}

