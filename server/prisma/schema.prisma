// ───────────── Arena: đấu code 1v1 (từ demo_web, nhánh test-usth, src/arena) ─────────────

enum ArenaMatchStatus {
  waiting
  active
  finished
  cancelled

  @@map("arena_match_status")
}

enum ArenaEndReason {
  solved
  timeout
  forfeit

  @@map("arena_end_reason")
}

enum ArenaSubmissionStatus {
  graded
  rejected
  error

  @@map("arena_submission_status")
}

model ArenaMatch {
  id               Int              @id @default(autoincrement())
  code             String           @unique @db.VarChar(8)
  isPublic         Boolean          @default(false) @map("is_public")
  status           ArenaMatchStatus @default(waiting)
  problemId        String           @map("problem_id") @db.VarChar(64)
  hostId           Int              @map("host_id")
  guestId          Int?             @map("guest_id")
  winnerId         Int?             @map("winner_id")
  endReason        ArenaEndReason?  @map("end_reason")
  hostRatingDelta  Int?             @map("host_rating_delta")
  guestRatingDelta Int?             @map("guest_rating_delta")
  hostXp           Int?             @map("host_xp")
  guestXp          Int?             @map("guest_xp")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt        DateTime?        @map("started_at") @db.Timestamptz(6)
  deadlineAt       DateTime?        @map("deadline_at") @db.Timestamptz(6)
  finishedAt       DateTime?        @map("finished_at") @db.Timestamptz(6)

  host        User              @relation("ArenaHost", fields: [hostId], references: [id])
  guest       User?             @relation("ArenaGuest", fields: [guestId], references: [id])
  winner      User?             @relation("ArenaWinner", fields: [winnerId], references: [id])
  submissions ArenaSubmission[]

  @@index([status, isPublic, createdAt])
  @@index([hostId, status])
  @@index([guestId, status])
  @@map("arena_matches")
}

model ArenaSubmission {
  id        Int                   @id @default(autoincrement())
  matchId   Int                   @map("match_id")
  userId    Int                   @map("user_id")
  code      String                @db.Text
  status    ArenaSubmissionStatus
  passed    Int                   @default(0)
  total     Int                   @default(0)
  // { "public": [{ "index": 0, "passed": true, "got": "...", "error": "..." }], "hiddenPassed": 3, "hiddenTotal": 5 }
  // KHÔNG chứa đầu vào/đầu ra mong đợi của test ẩn.
  detail    Json?
  message   String?               @db.VarChar(300)
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  gradedAt  DateTime?             @map("graded_at") @db.Timestamptz(6)

  match ArenaMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id])

  @@index([matchId, userId, createdAt])
  @@map("arena_submissions")
}

model ArenaRating {
  userId    Int      @id @map("user_id")
  rating    Int      @default(1000)
  wins      Int      @default(0)
  losses    Int      @default(0)
  draws     Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([rating(sort: Desc)])
  @@map("arena_ratings")
}

// ───────────── Arena · Đoán output: đấu nhanh 1v1 (từ pe-usth, máy tính Góc học) ─────────────
// Lịch câu hỏi KHÔNG lưu: dựng lại từ started_at + các câu trả lời (src/arena-quiz/quiz-logic.ts).

model ArenaQuizMatch {
  id               Int              @id @default(autoincrement())
  status           ArenaMatchStatus @default(waiting)
  hostId           Int              @map("host_id")
  guestId          Int?             @map("guest_id")
  winnerId         Int?             @map("winner_id")
  // [{ "qid": "q07", "opts": ["…", …], "answer": 2 }] — đáp án chỉ rời server khi câu đã đóng
  questions        Json
  // 'completed' | 'forfeit'
  endReason        String?          @map("end_reason") @db.VarChar(16)
  unscored         Boolean          @default(false)
  hostScore        Int              @default(0) @map("host_score")
  guestScore       Int              @default(0) @map("guest_score")
  hostRatingDelta  Int?             @map("host_rating_delta")
  guestRatingDelta Int?             @map("guest_rating_delta")
  hostXp           Int?             @map("host_xp")
  guestXp          Int?             @map("guest_xp")
  hostSeenAt       DateTime         @default(now()) @map("host_seen_at") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt        DateTime?        @map("started_at") @db.Timestamptz(6)
  finishedAt       DateTime?        @map("finished_at") @db.Timestamptz(6)

  host    User              @relation("QuizHost", fields: [hostId], references: [id])
  guest   User?             @relation("QuizGuest", fields: [guestId], references: [id])
  winner  User?             @relation("QuizWinner", fields: [winnerId], references: [id])
  answers ArenaQuizAnswer[]

  @@index([status, createdAt])
  @@index([hostId, status])
  @@index([guestId, status])
  @@map("arena_quiz_matches")
}

model ArenaQuizAnswer {
  id        Int      @id @default(autoincrement())
  matchId   Int      @map("match_id")
  userId    Int      @map("user_id")
  qIndex    Int      @map("q_index") @db.SmallInt
  choice    Int      @db.SmallInt
  correct   Boolean
  points    Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  match ArenaQuizMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id])

  @@unique([matchId, userId, qIndex])
  @@index([userId])
  @@map("arena_quiz_answers")
}

model ArenaQuizRating {
  userId    Int      @id @map("user_id")
  rating    Int      @default(1000)
  wins      Int      @default(0)
  losses    Int      @default(0)
  draws     Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([rating(sort: Desc)])
  @@map("arena_quiz_ratings")
}
